 /*
+ * The container profile may program the TDM data alignment for a host that
+ * right-justifies 24-bit samples in a 32-bit slot (TDMADJ=1). A standard I2S
+ * host (e.g. the mainline q6afe MI2S port) sends MSB-first, left-justified data
+ * one BCK after the WS edge, so the amplifier would read the sample 8 bits too
+ * low and be almost silent. Re-apply standard I2S alignment after the profile.
+ */
+static void tfa_apply_i2s_alignment(struct tfa_device *tfa)
+{
+	if (!tfa->i2s_msb_aligned)
+		return;
+	TFA_SET_BF(tfa, TDMDEL, 1);
+	TFA_SET_BF(tfa, TDMADJ, 0);
+}
+
+/*
  * start the clocks and wait until the AMP is switching
  *	on return the DSP sub system will be ready for loading
  */
@@ -2892,6 +2907,7 @@
 	// NOTE we may still have ACS=1 so we can switch sample rate here
 	err = tfaContWriteRegsProf(tfa, profile);
 	PRINT_ASSERT(err);
+	tfa_apply_i2s_alignment(tfa);
 
 	/* Factory trimming for the Boost converter */
 	tfa98xx_factory_trimmer(tfa);
@@ -3146,6 +3162,9 @@
 	if (err != Tfa98xx_Error_Ok)
 		goto error_exit;
 
+	/* profile switches and vstep files can rewrite the TDM registers */
+	tfa_apply_i2s_alignment(tfa);
+
 	tfa_dev_set_swprof(tfa, (unsigned short)next_profile);
 	tfa_dev_set_swvstep(tfa, (unsigned short)vstep);
 
