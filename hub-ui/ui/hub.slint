// Razer Phone 2 wall hub: landscape 1280x720 logical (sway: transform 90, scale 2).
// Left: device tiles from Home Assistant via the hub agent (tap = toggle, long-press = edit mode: drag to
// reorder, "隱藏" to hide). Right: microphone button + voice status. Status bar gear: settings sheet.
// When `dimmed` is true a full-screen catcher swallows the first touch and only wakes the screen.

export struct Device {
    id: string,
    name: string,
    room: string,
    kind: string,   // light | switch | fan | cover | climate
    on: bool,
    available: bool,
    glyph: string,  // one CJK character shown in the badge
    sub: string,    // state line, e.g. "開啟", "冷氣 26°", "離線"
}

// One of the user's YouTube Music playlists (Music Assistant library), page 3.
export struct PlaylistCard {
    name: string,
    cover: image,
    has-cover: bool,
}

// A queue entry after the current song ("接下來播放" on the now-playing page).
export struct QueueRow {
    title: string,
    artist: string,
    cover: image,
    has-cover: bool,
    index: int,     // absolute queue index (Music Assistant); -1 = only "the next one" is known
}

global Icons {
    out property <string> shuffle: "M10.59 9.17L5.41 4 4 5.41l5.17 5.17 1.42-1.41zM14.5 4l2.04 2.04L4 18.59 5.41 20 17.96 7.46 20 9.5V4h-5.5zm.33 9.41l-1.41 1.41 3.13 3.13L14.5 20H20v-5.5l-2.04 2.04-3.13-3.13z";
    out property <string> sync: "M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46C19.54 15.03 20 13.57 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74C4.46 8.97 4 10.43 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z";
}

// Settings gear: a round button (glyph 30 px), drawn as a button so it reads as tappable.
component GearButton inherits Rectangle {
    callback clicked();
    width: 52px;
    height: 52px;
    background: gear-ta.pressed ? #3a3a42 : #26262c;
    border-radius: 26px;
    Path {
        width: 30px;
        height: 30px;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: #c7c7cc;
        commands: "M19.14 12.94c.04-.31.06-.63.06-.94s-.02-.63-.06-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.49.49 0 0 0-.59-.22l-2.39.96a7.03 7.03 0 0 0-1.62-.94l-.36-2.54a.48.48 0 0 0-.48-.41h-3.84a.48.48 0 0 0-.48.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96a.48.48 0 0 0-.59.22L2.71 8.87a.48.48 0 0 0 .12.61l2.03 1.58c-.04.31-.06.63-.06.94s.02.63.06.94l-2.03 1.58a.49.49 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32a.48.48 0 0 0-.12-.61l-2.01-1.58zM12 15.6A3.6 3.6 0 1 1 12 8.4a3.6 3.6 0 0 1 0 7.2z";
    }
    gear-ta := TouchArea { clicked => { root.clicked(); } }
}

component StatusBar inherits Rectangle {
    in property <string> time;
    in property <string> date;
    in property <string> wifi;
    in property <string> battery;
    in property <string> ha;
    callback open-settings();
    height: 64px;
    // Right edge lines up with the mic panel below (28 px margin).
    HorizontalLayout {
        padding-left: 28px;
        padding-right: 28px;
        spacing: 18px;
        Text {
            text: root.time;
            font-size: 36px;
            font-weight: 700;
            color: #f2f2f7;
            vertical-alignment: center;
        }
        Text {
            text: root.date;
            font-size: 19px;
            color: #a1a1aa;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; }
        Text {
            text: root.ha;
            font-size: 17px;
            color: #8e8e93;
            vertical-alignment: center;
        }
        Text {
            text: root.wifi;
            font-size: 17px;
            color: #8e8e93;
            vertical-alignment: center;
        }
        Text {
            text: root.battery;
            font-size: 17px;
            color: #8e8e93;
            vertical-alignment: center;
        }
        GearButton {
            y: 6px;
            clicked => { root.open-settings(); }
        }
    }
}


component Tile inherits Rectangle {
    in property <Device> device;
    in property <bool> editing;
    // Current drag offset applied to this tile by the parent. TouchArea coordinates are relative to the tile,
    // which moves with the finger, so the finger's real displacement is (mouse - pressed) + offset.
    in property <length> offset-x;
    in property <length> offset-y;
    callback tapped();
    callback long-pressed();
    callback hide();
    callback rename();
    callback drag-delta(length, length);
    callback drag-released(length, length);

    property <bool> holding: false;
    property <bool> long-fired: false;
    property <bool> lit: root.device.on && root.device.available;

    border-radius: 24px;
    background: root.lit ? #f5c451 : #26262c;
    // pressed feedback: dim a little while the finger is down
    opacity: !root.device.available ? 0.55 : (ta.pressed && !root.editing ? 0.72 : 1.0);
    animate background { duration: 180ms; }
    animate opacity { duration: 90ms; }

    VerticalLayout {
        padding: 18px;
        spacing: 4px;
        HorizontalLayout {
            Rectangle {
                width: 52px;
                height: 52px;
                border-radius: 26px;
                background: root.lit ? #ffffff : #3a3a42;
                Text {
                    text: root.device.glyph;
                    font-size: 24px;
                    font-weight: 700;
                    color: root.lit ? #b7791f : #d1d1d6;
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        Rectangle { vertical-stretch: 1; }
        Text {
            text: root.device.name;
            font-size: 22px;
            font-weight: 700;
            color: root.lit ? #1c1c1e : #f2f2f7;
            overflow: elide;
        }
        Text {
            text: (root.device.room != "" ? root.device.room + "・" : "") + root.device.sub;
            font-size: 16px;
            color: root.lit ? #4a4a4f : #8e8e93;
            overflow: elide;
        }
    }

    if root.editing: Rectangle {
        border-radius: root.border-radius;
        border-width: 3px;
        border-color: #0a84ff;
        background: transparent;
    }

    ta := TouchArea {
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) {
                root.holding = true;
                root.long-fired = false;
            } else if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                root.holding = false;
                if (root.editing) {
                    root.drag-released(self.mouse-x - self.pressed-x + root.offset-x,
                                       self.mouse-y - self.pressed-y + root.offset-y);
                }
            }
        }
        moved => {
            if (root.editing) {
                root.drag-delta(self.mouse-x - self.pressed-x + root.offset-x,
                                self.mouse-y - self.pressed-y + root.offset-y);
            } else if (abs(self.mouse-x - self.pressed-x) > 12px || abs(self.mouse-y - self.pressed-y) > 12px) {
                root.holding = false;
            }
        }
        clicked => {
            if (!root.editing && !root.long-fired && root.device.available) {
                root.tapped();
            }
        }
    }

    // Edit mode: "改名" (voice dictation) and "隱藏" pills in the top-right corner (above the drag area).
    if root.editing: Rectangle {
        x: parent.width - 10px - 66px - 8px - 66px;
        y: 10px;
        width: 66px;
        height: 44px;
        border-radius: 22px;
        background: rename-ta.pressed ? #3a3a8e : #5e5ce6;
        Text { text: "改名"; font-size: 18px; font-weight: 700; color: white; }
        rename-ta := TouchArea { clicked => { root.rename(); } }
    }
    if root.editing: Rectangle {
        x: parent.width - self.width - 10px;
        y: 10px;
        width: 66px;
        height: 44px;
        border-radius: 22px;
        background: hide-ta.pressed ? #8e2b26 : #ff453a;
        Text { text: "隱藏"; font-size: 18px; font-weight: 700; color: white; }
        hide-ta := TouchArea { clicked => { root.hide(); } }
    }

    Timer {
        interval: 650ms;
        running: root.holding && !root.editing;
        triggered => {
            root.holding = false;
            root.long-fired = true;
            root.long-pressed();
        }
    }
}

// Pulsing discs shown only while listening/thinking; animation-tick() keeps redrawing only while this exists.
component VoiceRings inherits Rectangle {
    in property <bool> thinking;
    property <float> t: animation-tick() / 1s;
    for k in [0, 1, 2]: Rectangle {
        property <float> phase: Math.mod(root.t * (root.thinking ? 1.6 : 0.9) + k / 3, 1.0);
        width: 120px + 90px * self.phase;
        height: self.width;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        border-radius: self.width / 2;
        background: root.thinking ? #bf5af2 : #5e5ce6;
        opacity: 0.35 * (1 - self.phase);
    }
}

// Horizontal slider without std-widgets: drag or tap anywhere on the track. value is 0..1.
component Slider inherits Rectangle {
    in-out property <float> value;
    out property <bool> dragging: slider-ta.pressed;   // lets a parent swipe handler stand down
    property <int> last-step: -1;
    callback changed(float);
    callback step();                                    // crossed a 10 % step: selection tick
    height: 56px;
    Rectangle {
        y: (parent.height - 10px) / 2;
        height: 10px;
        border-radius: 5px;
        background: #3a3a42;
        Rectangle {
            x: 0px;
            width: parent.width * root.value;
            border-radius: 5px;
            background: #0a84ff;
        }
    }
    Rectangle {
        x: (root.width - 36px) * root.value;
        y: (root.height - 36px) / 2;
        width: 36px;
        height: 36px;
        border-radius: 18px;
        background: white;
    }
    slider-ta := TouchArea {
        function set(px: length) {
            root.value = clamp((px - 18px) / (root.width - 36px), 0, 1);
            root.changed(root.value);
            if (floor(root.value * 10) != root.last-step) {
                root.last-step = floor(root.value * 10);
                root.step();
            }
        }
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) { self.set(self.mouse-x); }
        }
        moved => { self.set(self.mouse-x); }
    }
}

// Round icon button for the now-playing controls.
// The visible disc shrinks while pressed (animated) so a press is obvious; the touch target keeps its full size.
component RoundButton inherits Rectangle {
    in property <string> icon;          // SVG path in a 24x24 viewbox
    in property <length> size: 80px;
    in property <bool> primary;
    in property <bool> active;          // toggle buttons (shuffle): lit when on
    callback clicked();
    width: self.size;
    height: self.size;
    // A tap on the touchscreen can be shorter than one frame, so besides "pressed" a click also plays a
    // 150 ms shrink-and-return pulse.
    property <bool> pulse;
    property <length> d: (rb-ta.pressed || self.pulse) ? root.size * 0.82 : root.size;
    Timer {
        interval: 150ms;
        running: root.pulse;
        triggered => { root.pulse = false; }
    }
    Rectangle {
        x: (root.size - root.d) / 2;
        y: (root.size - root.d) / 2;
        width: root.d;
        height: root.d;
        animate x, y, width, height { duration: 90ms; easing: ease-out; }
        border-radius: self.width / 2;
        background: rb-ta.pressed ? (root.primary ? #c7c7cc : #48484f)
                  : (root.primary ? #f2f2f7 : root.active ? #0a84ff : #2c2c32);
        animate background { duration: 90ms; }
        Path {
            width: root.d * 0.5;
            height: root.d * 0.5;
            viewbox-width: 24;
            viewbox-height: 24;
            fill: root.primary ? #101013 : #f2f2f7;
            commands: root.icon;
        }
    }
    rb-ta := TouchArea { clicked => { root.pulse = true; root.clicked(); } }
}

// Seekable progress bar: drag or tap; while the finger is down the bar follows it, the seek is sent on release.
component SeekBar inherits Rectangle {
    in property <float> position;
    in property <float> duration;
    out property <bool> dragging: seek-ta.pressed;
    property <float> drag-frac;
    property <int> last-step: -1;
    callback seek(float);              // seconds
    callback step();                   // crossed a 5 % step while dragging: selection tick
    changed drag-frac => {
        if (floor(self.drag-frac * 20) != self.last-step) {
            self.last-step = floor(self.drag-frac * 20);
            self.step();
        }
    }
    height: 40px;
    property <float> frac: seek-ta.pressed ? self.drag-frac
                         : (root.duration > 0 ? clamp(root.position / root.duration, 0, 1) : 0);
    Rectangle {
        y: (parent.height - self.height) / 2;
        height: seek-ta.pressed ? 12px : 8px;
        animate height { duration: 90ms; }
        border-radius: self.height / 2;
        background: #3a3a42;
        Rectangle {
            x: 0px;
            width: parent.width * root.frac;
            border-radius: parent.border-radius;
            background: #f2f2f7;
        }
    }
    Rectangle {
        x: parent.width * root.frac - self.width / 2;
        y: (parent.height - self.height) / 2;
        width: seek-ta.pressed ? 28px : 16px;
        height: self.width;
        animate width { duration: 90ms; }
        border-radius: self.width / 2;
        background: white;
        visible: root.duration > 0;
    }
    seek-ta := TouchArea {
        enabled: root.duration > 0;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) {
                root.drag-frac = clamp(self.mouse-x / root.width, 0, 1);
            } else if (ev.kind == PointerEventKind.up) {
                root.seek(root.drag-frac * root.duration);
            }
        }
        moved => { root.drag-frac = clamp(self.mouse-x / root.width, 0, 1); }
    }
}

component MusicPage inherits Rectangle {
    in property <string> state;         // playing | paused | idle | off ...
    in property <string> title;
    in property <string> artist;
    in property <image> cover;
    in property <bool> has-cover;
    in property <float> position;       // seconds
    in property <float> duration;
    in property <float> volume;         // 0..1
    out property <bool> slider-busy;    // finger on the volume slider: the page swipe must not take over
    out property <bool> seek-busy;      // same for the progress bar
    in property <bool> loading;         // optimistic: title shown, stream/cover still loading
    in property <bool> shuffle;
    in property <[QueueRow]> upnext;
    callback shuffle-toggle();
    callback play-queue(int);
    callback seek(float);
    callback haptic(int);
    callback prev();
    callback toggle();
    callback next();
    callback set-volume(float);
    callback activity();

    function mmss(s: float) -> string {
        return floor(s / 60) + ":" + (Math.mod(floor(s), 60) < 10 ? "0" : "") + Math.mod(floor(s), 60);
    }

    if root.title == "": Text {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height - 60px;
        text: "目前沒有播放音樂\n說「嘿賈伯斯，播放七里香」試試看";
        font-size: 24px;
        color: #8e8e93;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.title != "": Rectangle {
        // Cover
        Rectangle {
            x: 28px;
            y: 20px;
            width: 360px;
            height: 360px;
            border-radius: 24px;
            background: #26262c;
            clip: true;
            if root.has-cover: Image {
                width: parent.width;
                height: parent.height;
                source: root.cover;
                image-fit: ImageFit.cover;
            }
            if !root.has-cover && !root.loading: Text { text: "♪"; font-size: 96px; color: #48484f; }
            if root.loading: Rectangle {
                // pulsing placeholder while Music Assistant loads the stream / cover
                property <float> t: animation-tick() / 1s;
                opacity: 0.45 + 0.35 * Math.sin(self.t * 4rad);
                Text { y: 120px; text: "♪"; font-size: 96px; color: #8e8e93; }
                Text { y: 250px; text: "載入中…"; font-size: 22px; color: #8e8e93; }
            }
        }
        // Title, artist, progress, controls, volume
        property <length> col-x: 28px + 360px + 40px;
        property <length> col-w: root.width - self.col-x - 28px;
        Text {
            x: parent.col-x;
            y: 30px;
            width: parent.col-w;
            text: root.title;
            font-size: 38px;
            font-weight: 700;
            color: #f2f2f7;
            overflow: elide;
        }
        Text {
            x: parent.col-x;
            y: 86px;
            width: parent.col-w;
            text: root.artist;
            font-size: 24px;
            color: #a1a1aa;
            overflow: elide;
        }
        seek-bar := SeekBar {
            x: parent.col-x;
            y: 134px;
            width: parent.col-w;
            position: root.position;
            duration: root.duration;
            seek(s) => { root.activity(); root.seek(s); }
            step => { root.haptic(0); }
            changed dragging => { root.seek-busy = self.dragging; }
        }
        Text { x: parent.col-x; y: 166px; text: root.mmss(root.position); font-size: 16px; color: #8e8e93; }
        Text {
            x: parent.col-x;
            y: 166px;
            width: parent.col-w;
            text: root.duration > 0 ? root.mmss(root.duration) : "";
            font-size: 16px;
            color: #8e8e93;
            horizontal-alignment: right;
        }
        // shuffle (64) | 24 | prev (80) | 28 | play/pause (104) | 28 | next (80), centred in the column
        property <length> ctl-x: self.col-x + (self.col-w - 408px) / 2;
        RoundButton {
            x: parent.ctl-x;
            y: 234px;
            size: 64px;
            active: root.shuffle;
            icon: Icons.shuffle;
            clicked => { root.activity(); root.shuffle-toggle(); }
        }
        RoundButton {
            x: parent.ctl-x + 88px;
            y: 226px;
            size: 80px;
            icon: "M6 6h2v12H6zm3.5 6l8.5 6V6z";
            clicked => { root.activity(); root.prev(); }
        }
        RoundButton {
            x: parent.ctl-x + 196px;
            y: 214px;
            size: 104px;
            primary: true;
            icon: root.state == "playing" ? "M6 19h4V5H6v14zm8-14v14h4V5h-4z" : "M8 5v14l11-7z";
            clicked => { root.activity(); root.toggle(); }
        }
        RoundButton {
            x: parent.ctl-x + 328px;
            y: 226px;
            size: 80px;
            icon: "M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z";
            clicked => { root.activity(); root.next(); }
        }
        Text {
            x: parent.ctl-x;
            y: 302px;
            width: 64px;
            text: root.shuffle ? "隨機" : "依序";
            font-size: 15px;
            color: root.shuffle ? #0a84ff : #8e8e93;
            horizontal-alignment: center;
        }
        // Up next: up to 4 entries in one row (no scrolling, so it never fights the page swipe). Tap = play it.
        if root.upnext.length > 0: Text {
            x: 28px;
            y: 446px;
            text: "接下來播放";
            font-size: 18px;
            font-weight: 600;
            color: #8e8e93;
        }
        property <length> q-w: (root.width - 56px - 3 * 14px) / 4;
        for q[i] in root.upnext: Rectangle {
            visible: i < 4;
            x: 28px + i * (parent.q-w + 14px);
            y: 476px;
            width: parent.q-w;
            height: 84px;
            border-radius: 16px;
            background: q-ta.pressed ? #3a3a42 : #1f1f24;
            animate background { duration: 90ms; }
            Rectangle {
                x: 10px;
                y: 10px;
                width: 64px;
                height: 64px;
                border-radius: 10px;
                background: #2c2c32;
                clip: true;
                if q.has-cover: Image { width: parent.width; height: parent.height; source: q.cover; image-fit: ImageFit.cover; }
                if !q.has-cover: Text { text: "♪"; font-size: 28px; color: #48484f; }
            }
            Text {
                x: 86px;
                y: 14px;
                width: parent.width - 96px;
                text: q.title;
                font-size: 19px;
                font-weight: 600;
                color: #f2f2f7;
                overflow: elide;
            }
            Text {
                x: 86px;
                y: 44px;
                width: parent.width - 96px;
                text: q.artist;
                font-size: 16px;
                color: #8e8e93;
                overflow: elide;
            }
            q-ta := TouchArea { clicked => { root.activity(); root.play-queue(q.index); } }
        }
        Text { x: parent.col-x; y: 350px; text: "音樂音量  " + round(root.volume * 100) + "%"; font-size: 18px; color: #8e8e93; }
        vol-slider := Slider {
            x: parent.col-x;
            y: 374px;
            width: parent.col-w;
            value: root.volume;
            changed(v) => { root.activity(); root.set-volume(v); }
            step => { root.haptic(0); }
            changed dragging => { root.slider-busy = self.dragging; }
        }
    }
}

// Small pill button with an icon and a label (playlist page header).
component Chip inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <bool> active;
    callback clicked();
    height: 52px;
    width: 52px + chip-label.preferred-width + 22px;
    border-radius: 26px;
    background: c-ta.pressed ? #48484f : root.active ? #0a84ff : #2c2c32;
    animate background { duration: 90ms; }
    Path {
        x: 16px;
        y: (root.height - 26px) / 2;
        width: 26px;
        height: 26px;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: #f2f2f7;
        commands: root.icon;
    }
    chip-label := Text {
        x: 52px;
        text: root.text;
        font-size: 19px;
        font-weight: 600;
        color: #f2f2f7;
        vertical-alignment: center;
    }
    c-ta := TouchArea { clicked => { root.clicked(); } }
}

// Page 3: the user's own YouTube Music playlists. Tap a card = play it (shuffle or in order, per the toggle).
component PlaylistPage inherits Rectangle {
    in property <[PlaylistCard]> playlists;
    in property <bool> shuffle;
    in property <string> sync-state;    // "" | running | done | error
    in property <string> sync-text;
    callback play(int);
    callback shuffle-toggle();
    callback sync();
    callback activity();

    Text {
        x: 28px;
        y: 8px;
        text: "我的播放清單";
        font-size: 30px;
        font-weight: 700;
        color: #f2f2f7;
    }
    Text {
        x: 28px;
        y: 50px;
        width: root.width - 380px;
        text: root.sync-text;
        font-size: 16px;
        color: root.sync-state == "error" ? #ff6961 : #8e8e93;
        overflow: elide;
    }
    sync-chip := Chip {
        x: root.width - 28px - self.width;
        y: 6px;
        icon: Icons.sync;
        text: root.sync-state == "running" ? "同步中…" : "同步";
        clicked => { if (root.sync-state != "running") { root.activity(); root.sync(); } }
    }
    Chip {
        x: sync-chip.x - 14px - self.width;
        y: 6px;
        icon: Icons.shuffle;
        text: root.shuffle ? "隨機播放" : "依序播放";
        active: root.shuffle;
        clicked => { root.activity(); root.shuffle-toggle(); }
    }

    if root.playlists.length == 0: Text {
        x: 28px;
        y: 120px;
        width: root.width - 56px;
        text: "還沒有播放清單。\n在 YouTube Music 把清單加入「媒體庫」，再按右上角「同步」。";
        font-size: 22px;
        color: #8e8e93;
        wrap: word-wrap;
    }
    property <int> cols: 4;
    property <length> gap: 22px;
    property <length> card-w: (root.width - 56px - (self.cols - 1) * self.gap) / self.cols;
    property <length> cover-h: min(self.card-w, 190px);
    property <length> card-h: self.cover-h + 44px;
    Flickable {
        x: 0px;
        y: 80px;
        width: root.width;
        height: root.height - 80px;
        content-height: ceil(root.playlists.length / root.cols) * (root.card-h + root.gap);
        for p[i] in root.playlists: Rectangle {
            x: 28px + Math.mod(i, root.cols) * (root.card-w + root.gap);
            y: floor(i / root.cols) * (root.card-h + root.gap);
            width: root.card-w;
            height: root.card-h;
            property <length> shrink: p-ta.pressed ? 8px : 0px;
            animate shrink { duration: 90ms; easing: ease-out; }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: parent.shrink;
                width: root.cover-h - parent.shrink * 2;
                height: root.cover-h - parent.shrink * 2;
                border-radius: 18px;
                background: #26262c;
                clip: true;
                if p.has-cover: Image { width: parent.width; height: parent.height; source: p.cover; image-fit: ImageFit.cover; }
                if !p.has-cover: Text { text: "♪"; font-size: 64px; color: #48484f; }
            }
            Text {
                x: 0px;
                y: root.cover-h + 8px;
                width: parent.width;
                text: p.name;
                font-size: 20px;
                font-weight: 600;
                color: #f2f2f7;
                horizontal-alignment: center;
                overflow: elide;
            }
            p-ta := TouchArea { clicked => { root.activity(); root.play(i); } }
        }
    }
}

component SheetButton inherits Rectangle {
    in property <string> text;
    in property <color> base: #2c2c32;
    in property <color> fg: #f2f2f7;
    callback clicked();
    height: 64px;
    border-radius: 32px;
    background: bta.pressed ? #48484f : root.base;
    Text { text: root.text; font-size: 21px; font-weight: 600; color: root.fg; }
    bta := TouchArea { clicked => { root.clicked(); } }
}

export component HubWindow inherits Window {
    title: "Razer Hub";
    preferred-width: 1280px;
    preferred-height: 720px;
    no-frame: true;
    background: #101013;
    default-font-family: "Noto Sans CJK TC";

    in property <[Device]> devices;
    in property <string> time;
    in property <string> date;
    in property <string> wifi;
    in property <string> battery;
    in property <string> ha: "HA 未連線";
    in property <bool> dimmed;
    in-out property <bool> editing;
    in property <string> voice-state: "idle";   // idle | listening | thinking | done
    in property <string> voice-text: "";
    in property <float> volume: 0.4;              // 0..1 (PipeWire default sink)
    in property <bool> muted;
    in property <bool> volume-shown;              // set by Rust on a volume key, cleared after a timeout
    in-out property <bool> settings-open: false;
    in-out property <float> brightness: 0.45;     // 0..1 of the active backlight level
    in property <int> hidden-count;
    in property <string> timezone;

    in-out property <int> page: 0;               // 0 devices, 1 now playing, 2 my playlists
    in-out property <string> music-state: "off"; // in-out: play/pause flips optimistically before HA confirms
    in property <bool> music-loading;
    callback music-seek(float);
    callback haptic(int);                        // 0 selection tick, 1 light, 2 medium, 3 heavy
    in property <string> music-title;
    in property <string> music-artist;
    in property <image> music-cover;
    in property <bool> music-has-cover;
    in property <float> music-position;
    in property <float> music-duration;
    in property <float> music-volume: 0.3;
    callback music-cmd(string);                  // previous | next | pause | resume | shuffle | sync
    callback music-set-volume(float);
    in-out property <bool> music-shuffle;        // in-out: flips optimistically
    in property <[QueueRow]> upnext;
    in property <[PlaylistCard]> playlists;
    in property <string> sync-state;
    in property <string> sync-text;
    callback play-playlist(int);
    callback play-queue(int);

    callback toggle-device(int);
    callback hide-device(int);
    callback rename-device(int);                 // next utterance becomes the tile's name
    callback reset-names();
    in property <int> renamed-count;
    callback drop-device(int, float, float);     // index, moved columns, moved rows (unrounded)
    callback mic-pressed();
    callback wake();
    callback activity();
    callback switch-desktop();                   // to the Phosh debug desktop
    callback set-volume(float);
    callback set-brightness(float);
    callback unhide-all();

    property <int> cols: 4;
    property <length> gap: 18px;
    property <length> margin: 28px;
    property <length> panel-w: 250px;
    property <length> grid-top: 76px;
    property <length> grid-w: root.width - 2 * root.margin - root.panel-w - root.gap;
    property <length> cell-w: (root.grid-w - (root.cols - 1) * root.gap) / root.cols;
    property <length> cell-h: 148px;
    property <int> drag-index: -1;
    property <length> drag-dx: 0px;
    property <length> drag-dy: 0px;

    StatusBar {
        x: 0px;
        y: 4px;
        width: root.width;
        time: root.time;
        date: root.date;
        wifi: root.wifi;
        battery: root.battery;
        ha: root.ha;
        open-settings => {
            root.activity();
            root.haptic(1);
            root.editing = false;
            root.settings-open = true;
        }
    }

    // Left area: swipe between the device tiles (page 0) and now playing (page 1). The mic panel on the right
    // stays put. Swiping is off in edit mode so it never fights a tile drag.
    property <length> page-w: root.margin + root.grid-w + root.gap / 2;
    Rectangle {
        x: 0px;
        y: root.grid-top;
        width: root.page-w;
        height: root.height - root.grid-top;
        clip: true;
        swipe := SwipeGestureHandler {
            width: parent.width;
            height: parent.height;
            property <bool> music-busy: root.page == 1 && (music-page.slider-busy || music-page.seek-busy);
            handle-swipe-left: !root.editing && root.page < 2 && !self.music-busy;
            handle-swipe-right: !root.editing && root.page > 0 && !self.music-busy;
            swiped => {
                root.activity();
                root.page = self.current-position.x < self.pressed-position.x ? min(root.page + 1, 2)
                                                                            : max(root.page - 1, 0);
            }
            Rectangle {
                x: -root.page * root.page-w
                   + (swipe.swiping ? clamp(swipe.current-position.x - swipe.pressed-position.x, -root.page-w, root.page-w) : 0px);
                animate x { duration: swipe.swiping ? 0ms : 260ms; easing: ease-out; }
                width: root.page-w * 3;
                height: parent.height;

                if root.devices.length == 0: Text {
                    x: root.margin;
                    y: 40px;
                    width: root.grid-w;
                    text: root.ha == "HA 已連線" ? "沒有可顯示的裝置（齒輪 → 顯示隱藏的裝置）" : "正在連線 Home Assistant…";
                    font-size: 22px;
                    color: #8e8e93;
                }

    for d[i] in root.devices: Tile {
        device: d;
        editing: root.editing;
        offset-x: i == root.drag-index ? root.drag-dx : 0px;
        offset-y: i == root.drag-index ? root.drag-dy : 0px;
        width: root.cell-w;
        height: root.cell-h;
        x: root.margin + Math.mod(i, root.cols) * (root.cell-w + root.gap) + (i == root.drag-index ? root.drag-dx : 0px);
        y: floor(i / root.cols) * (root.cell-h + root.gap) + (i == root.drag-index ? root.drag-dy : 0px);
        z: i == root.drag-index ? 10 : 0;
        tapped => {
            root.activity();
            root.toggle-device(i);
        }
        long-pressed => {
            root.activity();
            root.haptic(3);
            root.editing = true;
        }
        hide => {
            root.activity();
            root.hide-device(i);
        }
        rename => {
            root.activity();
            root.rename-device(i);
        }
        drag-delta(dx, dy) => {
            root.activity();
            root.drag-index = i;
            root.drag-dx = dx;
            root.drag-dy = dy;
        }
        drag-released(dx, dy) => {
            root.drag-index = -1;
            root.drag-dx = 0px;
            root.drag-dy = 0px;
            root.drop-device(i, dx / (root.cell-w + root.gap), dy / (root.cell-h + root.gap));
        }
    }

                music-page := MusicPage {
                    x: root.page-w;
                    y: 0px;
                    width: root.page-w;
                    height: parent.height - 50px;
                    state: root.music-state;
                    title: root.music-title;
                    artist: root.music-artist;
                    cover: root.music-cover;
                    has-cover: root.music-has-cover;
                    position: root.music-position;
                    duration: root.music-duration;
                    volume: root.music-volume;
                    loading: root.music-loading;
                    prev => { root.music-cmd("previous"); }
                    next => { root.music-cmd("next"); }
                    toggle => {
                        if (root.music-state == "playing") {
                            root.music-state = "paused";
                            root.music-cmd("pause");
                        } else {
                            root.music-state = "playing";
                            root.music-cmd("resume");
                        }
                    }
                    seek(s) => { root.music-seek(s); }
                    haptic(l) => { root.haptic(l); }
                    set-volume(v) => { root.music-set-volume(v); }
                    activity => { root.activity(); }
                    shuffle: root.music-shuffle;
                    upnext: root.upnext;
                    shuffle-toggle => { root.music-shuffle = !root.music-shuffle; root.music-cmd("shuffle"); }
                    play-queue(i) => { root.play-queue(i); }
                }
                PlaylistPage {
                    x: root.page-w * 2;
                    y: 0px;
                    width: root.page-w;
                    height: parent.height - 50px;
                    playlists: root.playlists;
                    shuffle: root.music-shuffle;
                    sync-state: root.sync-state;
                    sync-text: root.sync-text;
                    play(i) => { root.play-playlist(i); }
                    shuffle-toggle => { root.music-shuffle = !root.music-shuffle; root.music-cmd("shuffle"); }
                    sync => { root.haptic(1); root.music-cmd("sync"); }
                    activity => { root.activity(); }
                }
            }
        }
        // Page dots (tap to switch too)
        for p in [0, 1, 2]: Rectangle {
            x: (root.page-w - 3 * 44px) / 2 + p * 44px;
            y: parent.height - 30px - root.margin / 2;
            width: 44px;
            height: 30px;
            Rectangle {
                width: root.page == p ? 24px : 10px;
                height: 10px;
                border-radius: 5px;
                background: root.page == p ? #f2f2f7 : #48484f;
                animate width { duration: 200ms; }
            }
            TouchArea { clicked => { root.activity(); root.haptic(1); root.page = p; } }
        }
    }

    // Right panel: microphone
    Rectangle {
        x: root.width - root.margin - root.panel-w;
        y: root.grid-top;
        width: root.panel-w;
        height: root.height - root.grid-top - root.margin;
        border-radius: 28px;
        background: #18181d;

        mic-area := Rectangle {
            x: (parent.width - 220px) / 2;
            y: 70px;
            width: 220px;
            height: 220px;
            if root.voice-state == "listening" || root.voice-state == "thinking": VoiceRings {
                width: parent.width;
                height: parent.height;
                thinking: root.voice-state == "thinking";
            }
            Rectangle {
                x: 50px;
                y: 50px;
                width: 120px;
                height: 120px;
                border-radius: 60px;
                background: @linear-gradient(135deg, #5e5ce6 0%, #bf5af2 55%, #ff375f 100%);
                Path {
                    x: 34px;
                    y: 30px;
                    width: 52px;
                    height: 60px;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    fill: white;
                    commands: "M12 14a3 3 0 0 0 3-3V5a3 3 0 0 0-6 0v6a3 3 0 0 0 3 3zm5-3a5 5 0 0 1-10 0H5a7 7 0 0 0 6 6.93V21h2v-3.07A7 7 0 0 0 19 11h-2z";
                }
                TouchArea {
                    clicked => {
                        root.activity();
                        root.mic-pressed();
                    }
                }
            }
        }

        Text {
            x: 16px;
            y: mic-area.y + mic-area.height + 24px;
            width: parent.width - 32px;
            text: root.voice-text != "" ? root.voice-text : "說「嘿賈伯斯」\n或點一下開始說話";
            font-size: 20px;
            color: #d1d1d6;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        // Edit mode: a large Done button at the bottom of the panel (easy to reach, away from the screen edge).
        if root.editing: Rectangle {
            x: 20px;
            y: parent.height - 20px - 76px;
            width: parent.width - 40px;
            height: 76px;
            border-radius: 38px;
            background: done-ta.pressed ? #0060c8 : #0a84ff;
            Text {
                text: "完成";
                font-size: 28px;
                font-weight: 700;
                color: white;
            }
            done-ta := TouchArea {
                clicked => {
                    root.activity();
                    root.haptic(1);
                    root.editing = false;
                }
            }
        }
        if root.editing: Text {
            x: 16px;
            y: parent.height - 20px - 76px - 44px;
            width: parent.width - 32px;
            text: "拖曳排列・改名用說的";
            font-size: 17px;
            color: #8e8e93;
            horizontal-alignment: center;
        }
    }

    // Volume overlay (volume keys): slides down from under the status bar, fades out.
    Rectangle {
        property <length> w: 420px;
        x: (root.width - self.w) / 2;
        y: root.volume-shown ? 84px : 40px;
        width: self.w;
        height: 72px;
        z: 50;
        opacity: root.volume-shown ? 1 : 0;
        visible: self.opacity > 0;
        animate y { duration: 220ms; easing: ease-out; }
        animate opacity { duration: 220ms; }
        border-radius: 36px;
        background: #2c2c32;
        Path {
            x: 24px;
            y: 18px;
            width: 36px;
            height: 36px;
            viewbox-width: 24;
            viewbox-height: 24;
            fill: root.muted ? #8e8e93 : #f2f2f7;
            commands: root.muted || root.volume <= 0
                ? "M3 9v6h4l5 5V4L7 9H3zm13.6 3 2.7-2.7-1.4-1.4-2.7 2.7-2.7-2.7-1.4 1.4 2.7 2.7-2.7 2.7 1.4 1.4 2.7-2.7 2.7 2.7 1.4-1.4z"
                : "M3 9v6h4l5 5V4L7 9H3zm13.5 3A4.5 4.5 0 0 0 14 8v8a4.5 4.5 0 0 0 2.5-4zM14 3.2v2.1a7 7 0 0 1 0 13.4v2.1a9 9 0 0 0 0-17.6z";
        }
        Rectangle {
            x: 76px;
            y: (parent.height - 12px) / 2;
            width: parent.width - 76px - 84px;
            height: 12px;
            border-radius: 6px;
            background: #48484f;
            Rectangle {
                x: 0px;
                width: parent.width * clamp(root.muted ? 0 : root.volume, 0, 1);
                height: parent.height;
                border-radius: 6px;
                background: #f2f2f7;
                animate width { duration: 120ms; }
            }
        }
        Text {
            x: parent.width - 72px;
            width: 56px;
            height: parent.height;
            text: root.muted ? "靜音" : round(root.volume * 100) + "%";
            font-size: 20px;
            font-weight: 600;
            color: #f2f2f7;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }

    // Settings sheet (gear icon).
    if root.settings-open: Rectangle {
        z: 90;
        width: root.width;
        height: root.height;
        background: #000000b0;
        TouchArea { clicked => { root.activity(); root.settings-open = false; } }
        // Two columns so everything fits the 720 px height: sliders + status left, actions right
        // (one tall column pushed the buttons off the bottom of the screen; user 2026-11-12).
        Rectangle {
            x: 28px;
            y: 76px;
            width: root.width - 56px;
            height: root.height - 76px - 28px;
            border-radius: 28px;
            background: #1c1c21;
            TouchArea { clicked => { root.activity(); } }   // keep taps on the sheet from closing it
            VerticalLayout {
                padding: 28px;
                spacing: 18px;
                HorizontalLayout {
                    Text { text: "設定"; font-size: 30px; font-weight: 700; color: #f2f2f7; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Rectangle {
                        width: 56px;
                        height: 56px;
                        border-radius: 28px;
                        background: close-ta.pressed ? #3a3a42 : #2c2c32;
                        Text { text: "✕"; font-size: 24px; color: #f2f2f7; }
                        close-ta := TouchArea { clicked => { root.activity(); root.haptic(1); root.settings-open = false; } }
                    }
                }
                HorizontalLayout {
                    spacing: 40px;
                    VerticalLayout {
                        horizontal-stretch: 3;
                        spacing: 10px;
                        alignment: start;
                        Text { text: "亮度"; font-size: 18px; color: #8e8e93; }
                        Slider {
                            value: root.brightness;
                            changed(v) => { root.activity(); root.brightness = v; root.set-brightness(v); }
                            step => { root.haptic(0); }
                        }
                        Text { text: "音量  " + round(root.volume * 100) + "%"; font-size: 18px; color: #8e8e93; }
                        Slider {
                            value: root.volume;
                            changed(v) => { root.activity(); root.set-volume(v); }
                            step => { root.haptic(0); }
                        }
                        Rectangle { height: 14px; }
                        Text { text: root.wifi + "    " + root.battery; font-size: 18px; color: #d1d1d6; }
                        Text { text: "時間：網路自動校時（" + root.timezone + "）"; font-size: 18px; color: #d1d1d6; }
                        Text { text: root.ha; font-size: 18px; color: #d1d1d6; }
                    }
                    VerticalLayout {
                        horizontal-stretch: 2;
                        spacing: 14px;
                        alignment: start;
                        Text { text: "裝置"; font-size: 18px; color: #8e8e93; }
                        if root.hidden-count > 0: SheetButton {
                            text: "顯示 " + root.hidden-count + " 個已隱藏的裝置";
                            clicked => { root.activity(); root.haptic(1); root.unhide-all(); }
                        }
                        if root.renamed-count > 0: SheetButton {
                            text: "還原 " + root.renamed-count + " 個自訂名稱";
                            clicked => { root.activity(); root.haptic(1); root.reset-names(); }
                        }
                        if root.hidden-count == 0 && root.renamed-count == 0: Text {
                            text: "沒有隱藏或改名的裝置";
                            font-size: 18px;
                            color: #636366;
                        }
                        Rectangle { height: 10px; }
                        Text { text: "系統"; font-size: 18px; color: #8e8e93; }
                        SheetButton {
                            text: "切換到除錯桌面";
                            base: #3a1f1d;
                            fg: #ff6961;
                            clicked => { root.haptic(2); root.settings-open = false; root.switch-desktop(); }
                        }
                    }
                }
                Rectangle { vertical-stretch: 1; }
            }
        }
    }

    // First touch on a dimmed screen only wakes it.
    if root.dimmed: TouchArea {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        z: 100;
        clicked => { root.wake(); }
    }
}
