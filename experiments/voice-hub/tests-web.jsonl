{"id": 322, "cat": "short_name", "text": "吸頂燈關掉", "expect": [["light.bedroom_ceiling", "turn_off"]]}
{"id": 323, "cat": "ambiguous", "text": "空調開二十六", "expect_clarify": true}
{"id": 324, "cat": "synonym", "text": "電視燈條關掉", "expect": [["light.living_strip", "turn_off"]]}
{"id": 325, "cat": "single", "text": "氣氛燈調到最暗", "expect": [["light.living_strip", "set_brightness", 1]], "accept_clarify": true}
{"id": 326, "cat": "single", "text": "風扇風速開到最大", "expect": [["fan.living", "set_percentage", 100]]}
{"id": 327, "cat": "scene", "text": "晚安", "expect_reject": true, "note": "尚未定義場景，不可猜"}
{"id": 328, "cat": "multi", "text": "臥室的冷氣幫我打開，二十六度", "expect": [["climate.bedroom_ac", "turn_on"], ["climate.bedroom_ac", "set_temperature", 26]], "alt": [[["climate.bedroom_ac", "set_temperature", 26]]]}
{"id": 329, "cat": "fragment", "text": "客廳的燈", "expect_clarify": true}
{"id": 330, "cat": "query", "text": "洗衣機洗好了沒", "expect_reject": true}
{"id": 331, "cat": "multi", "text": "把臥室窗簾拉上，順便把床頭燈調到百分之二十", "expect": [["cover.bedroom_curtain", "close"], ["light.bedside", "set_brightness", 20]]}
{"id": 332, "cat": "relative", "text": "冷氣調低兩度", "expect": [["climate.living_ac", "adjust_temperature", -2]], "accept_clarify": true}
{"id": 333, "cat": "asr_error", "text": "客聽的燈全部關掉", "expect": [["light.living_main", "turn_off"], ["light.living_strip", "turn_off"]]}
{"id": 334, "cat": "unknown_area_word", "text": "臥房大燈關掉", "expect": [["light.bedroom_ceiling", "turn_off"]], "note": "「臥房」不在區域別名裡"}
{"id": 335, "cat": "synonym", "text": "主臥冷氣開二十五度", "expect": [["climate.bedroom_ac", "set_temperature", 25]]}
{"id": 336, "cat": "colloquial", "text": "電扇停掉", "expect": [["fan.living", "turn_off"]], "note": "電扇已關，驗證器去掉後是空動作"}
